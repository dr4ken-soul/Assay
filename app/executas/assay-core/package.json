{
  "name": "assay-core",
  "version": "0.1.5",
  "description": "The Assay Executa. Blind multi-model trial execution, blind examination and routing policy.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "assay-core": "dist/index.js"
  },
  "files": [
    "dist",
    "executa.json",
    "manifest.json"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "artifacts": "node scripts/build-artifacts.mjs",
    "prepublishOnly": "npm run build && npm test && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "anna",
    "executa",
    "llm",
    "evaluation",
    "benchmark",
    "model-routing",
    "blind-trial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dr4ken-soul/Assay.git"
  },
  "homepage": "https://assay-psycho-projects.vercel.app"
}
